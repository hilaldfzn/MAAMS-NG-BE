# Copy to .env for local development. On Vercel/Cloud Run set these as environment variables.

DATABASE_URL=postgres://user:password@localhost:5432/maams
SECRET_KEY=change-me
DEBUG=True

# JWT issued to the frontend after Google / SSO UI login
ACCESS_TOKEN_SECRET_KEY=change-me
REFRESH_TOKEN_SECRET_KEY=change-me
ACCESS_TOKEN_EXP_TIME=1800
REFRESH_TOKEN_EXP_TIME=3600

# Must be the same OAuth client the frontend's NextAuth Google provider uses
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SSO UI (CAS). SERVICE_URL must equal the frontend callback the login redirect used
CAS_URL=https://sso.ui.ac.id/cas2
SERVICE_URL=http://localhost:3000/auth/callback
ORIGIN_URL=http://localhost:3000

# Root cause validation
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

SENTRY_DSN=
